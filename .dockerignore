# The multi-stage Dockerfile needs the Go source and the pre-built web export
# (web/site/out) for //go:embed. Exclude everything else to shrink context.
.git
.github
**/node_modules
web/site/.next
web/site/src
web/site/public
web/site/tsconfig.tsbuildinfo
bin/
**/.DS_Store
.env
.env.local
serverConfig.xml
