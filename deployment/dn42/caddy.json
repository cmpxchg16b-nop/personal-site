{
  "logging": {
    "logs": {
      "default": {
        "writer": {
          "output": "stdout"
        },
        "encoder": {
          "format": "console"
        }
      }
    }
  },
  "storage": {
    "module": "file_system",
    "root": "/caddydata"
  },
  "apps": {
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "module": "acme",
                "ca": "https://acme.burble.dn42/v1/dn42/acme/directory",
                "test_ca": "https://acme.burble.dn42/v1/staging/acme/directory",
                "email": "{env.ACME_CONTACT_EMAIL}",
                "acme_timeout": "300s",
                "trusted_roots_pem_files": ["/dn42-root-ca.crt"]
              }
            ]
          }
        ]
      }
    },
    "http": {
      "servers": {
        "main": {
          "listen": [":443", ":80"],
          "routes": [
            {
              "group": "main",
              "match": [
                {
                  "host": ["nexus.dn42"]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "[fdda:8ca4:1556:3000::8376:bf72]:18972"
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
