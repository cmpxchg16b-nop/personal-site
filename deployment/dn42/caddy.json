{
  "logging": {
    "logs": {
      "default": {
        "writer": {
          "output": "stdout"
        },
        "encoder": {
          "format": "console"
        }
      }
    }
  },
  "storage": {
    "module": "file_system",
    "root": "/caddydata"
  },
  "apps": {
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "module": "acme",
                "ca": "https://acme.burble.dn42/v1/dn42/acme/directory",
                "test_ca": "https://acme.burble.dn42/v1/staging/acme/directory",
                "email": "{env.ACME_CONTACT_EMAIL}",
                "acme_timeout": "300s",
                "trusted_roots_pem_files": ["/dn42-root-ca.crt"]
              }
            ]
          }
        ]
      }
    },
    "http": {
      "servers": {
        "http": {
          "listen": [":80"],
          "routes": [
            {
              "group": "http_redirect",
              "match": [
                {
                  "host": [
                    "nexus.dn42",
                    "chat.dn42",
                    "exam.edu.dn42",
                    "testcenter.edu.dn42"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 308,
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  }
                }
              ],
              "terminal": true
            }
          ]
        },
        "https": {
          "listen": [":443"],
          "routes": [
            {
              "group": "nexus",
              "match": [
                {
                  "host": ["nexus.dn42"],
                  "path": ["/mystream/whep", "/mystream/whep/*"]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "172.20.0.1:8889"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "group": "nexus",
              "match": [
                {
                  "host": ["nexus.dn42"]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "[fdda:8ca4:1556:3000::8376:bf72]:18972"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "group": "testcenter",
              "match": [
                {
                  "host": ["exam.edu.dn42", "testcenter.edu.dn42"]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "[fdda:8ca4:1556:3000::8376:bf72]:18971"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "group": "chat",
              "match": [
                {
                  "host": ["chat.dn42"]
                }
              ],
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 308,
                  "headers": {
                    "Location": ["https://nexus.dn42/chat"]
                  }
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
