<?xml version="1.0" encoding="UTF-8"?>
<!-- Global server configuration, validated against serverConfig.xsd (project
     root). The <dynBlogData/> section is served live by the site's /api/dyn/
     and /links/ endpoints; the server re-reads this document on every
     request, so edits apply without a restart. -->
<serverConfig
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="serverConfig.xsd"
>
  <!-- The site's dynamic blog data, served to the frontend as JSON under
       /api/dyn/ (see pkg/api/dyn). A project's tech attribute and a post's
       tags attribute are comma-separated lists rendered as chips. All
       entries below are placeholders. -->
  <dynBlogData>
    <postMetadata
      id="my-first-post"
      href="/posts/my-first-post"
      title="第一篇博客"
      description="记录新博客网站的设计思路"
      creation="2026-08-17T18:22:00+08:00"
      tags="blog,dev"
    />
    <project
      id="cloudping"
      name="CloudPing"
      description="A web-based distributed online ping &amp; traceroute system."
      url="/links/cloudping"
      tech="Go,Next.js"
    />
    <project
      id="examserver"
      name="ExamServer"
      description="An online testcenter focus on simplicity."
      url="/links/examserver"
      tech="TypeScript,React"
    />
    <authorContact
      id="email"
      kind="email"
      label="Email"
      url="mailto:i@exploro.one"
    />
    <authorContact
      id="github"
      kind="github"
      label="Github"
      url="/links/gh"
    />
    <authorContact
      id="website"
      kind="website"
      label="Website"
      url="/links/home"
    />
    <!-- Short links, served as 302 redirects under /links/ (see
         pkg/api/links): GET /links/{id} redirects to href. All entries
         below are placeholders. -->
    <shortlink id="home" href="/" />
    <shortlink id="gh" href="https://github.com/cmpxchg16b-nop" />
    <shortlink id="examserver" href="https://github.com/cmpxchg16b-nop/dcna-questions" />
    <shortlink id="cloudping" href="https://github.com/internetworklab/globalping" />
  </dynBlogData>
</serverConfig>