<?xml version="1.0" encoding="UTF-8" ?>
<!-- Global server configuration, validated against serverConfig.xsd (project
     root). The <dynBlogData/> section is served live by the site's
     /api/dyn/ and /links/ endpoints; the server re-reads this document on
     every request, so edits apply without a restart. -->
<serverConfig
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="serverConfig.xsd"
>
  <!-- The site's dynamic blog data (optional): post metadata, projects, and
       author contacts served to the frontend as JSON under /api/dyn/ (see
       pkg/api/dyn), plus short links served as 302 redirects under /links/
       (see pkg/api/links). A project's tech attribute and a post's tags
       attribute are comma-separated lists. Every entry carries a unique
       id. -->
  <dynBlogData>
    <postMetadata
      id="your-first-post"
      href="/posts/your-first-post"
      title="Your first post title"
      description="A one- or two-sentence summary of the post goes here."
      creation="2026-03-01"
      tags="meta,example"
    />
    <project
      id="project-one"
      name="Project One"
      description="A short description of what this project does."
      url="https://github.com/your-handle/project-one"
      tech="Go,Next.js"
    />
    <authorContact
      id="email"
      kind="email"
      label="you@example.com"
      url="mailto:you@example.com"
    />
    <authorContact
      id="github"
      kind="github"
      label="github.com/your-handle"
      url="https://github.com/your-handle"
    />
    <shortlink id="gh" href="https://github.com/your-handle" />
    <shortlink id="first-post" href="/posts/your-first-post" />
  </dynBlogData>

  <!-- Generic OIDC login providers (optional), consumed by the generic OIDC
       login handler (pkg/api/login/oidc/general). Each <oidcLoginOption/>
       registers a handler at /api/login/oidc/{providerName}/; entries with
       an empty issuerURL are ignored by the server.

       sessionLifespan is a Go time.Duration string (e.g. "168h"); when
       omitted the handler's code-side default applies. redirectURL may be
       relative (start with "/"), in which case the origin of the incoming
       request is prepended; the origin must match an <allowedOrigin/>
       entry below.
  <oidcLoginOptions>
    <oidcLoginOption
      providerName="myidp"
      issuerURL="https://auth.example.com"
      clientId=""
      clientSecret=""
      redirectURL="/api/login/oidc/myidp/auth"
      scope="openid profile email"
      sessionLifespan="168h"
      loginSuccessRedirectURL="/"
    />
  </oidcLoginOptions>
  -->

  <!-- The Github OAuth login provider (optional), consumed by the Github
       OAuth login handler (pkg/api/login/oauth2/github) at
       /api/login/oauth2/github/. The handler is wired only when clientId is
       non-empty. redirectURL may be relative (start with "/"), in which
       case the origin of the incoming request is prepended; the origin must
       match an <allowedOrigin/> entry below. loginPage, scope,
       tokenEndpoint, sessionLifespan (a Go time.Duration string) and
       loginSuccessRedirectURL have code-side defaults and may be omitted.
  <githubOAuthLogin
    clientId=""
    appSecret=""
    redirectURL="/api/login/oauth2/github/auth"
    scope="read:user"
    sessionLifespan="168h"
    loginSuccessRedirectURL="/"
  />
  -->

  <!-- The login page's configurable IdP list (optional), served to the
       frontend as JSON by GET /api/login/loginoptions. Options with an empty
       loginURL are hidden by the login page.
  <loginOptions>
    <loginOption
      kind="github"
      name="github"
      displayName="Github"
      loginURL="/api/login/oauth2/github/start"
    />
    <loginOption
      kind="visitor"
      name="visitor"
      displayName=""
      label="Sign in as Visitor"
      loginURL="/api/login/visitor"
    />
  </loginOptions>
  -->

  <!-- Origins ("scheme://host") trusted by the OAuth2/OIDC login handlers
       when their configured redirect URL is relative (optional).
  <allowedOrigin>http://localhost:8080</allowedOrigin>
  -->

  <!-- ICE server sets for the WebRTC sessions brokered by the signalling
       server (optional), served by GET /api/iceServers (see
       pkg/api/iceservers). urls is a comma-separated list of ICE server
       URLs; an entry without allowedOrigin applies to every request
       origin, otherwise only to that origin; matching entries' URLs are
       concatenated and deduplicated.
  <iceServer urls="stun:stun.l.google.com:19302" />
  <iceServer
    urls="stun:stun.example.com:3478"
    allowedOrigin="https://www.example.com"
  />
  -->
</serverConfig>
