<?xml version="1.0" encoding="UTF-8" ?>
<!-- Schema for serverConfig.xml, the global server configuration document.
     The XML instance references this schema via
     xsi:noNamespaceSchemaLocation="serverConfig.xsd". -->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <!-- Root element; holds the global configuration sections. Each section is
       optional so a minimal document enables only what it needs. -->
  <xsd:element name="serverConfig">
    <xsd:complexType>
      <xsd:sequence>
        <!-- The site's dynamic blog data: the post metadata, project, and
             author-contact lists served to the frontend as JSON under
             /api/dyn/ (see pkg/api/dyn), and the short links served as
             redirects under /links/ (see pkg/api/links). The server re-reads
             this section from the document on every request
             (FSBasedDynBlogData in pkg/models/dyn, FsShortLinkDataProvider
             in pkg/models/shortlink), so edits apply without a server
             restart. -->
        <xsd:element name="dynBlogData" type="dynBlogDataType" minOccurs="0" />
        <!-- The configurable list of generic OIDC login providers, consumed
             by the generic OIDC login handler (see
             pkg/api/login/oidc/general). -->
        <xsd:element
          name="oidcLoginOptions"
          type="oidcLoginOptionsType"
          minOccurs="0"
        />
        <!-- The single Github OAuth login provider, consumed by the Github
             OAuth login handler (see pkg/api/login/oauth2/github). When the
             element is absent, no Github login endpoint is wired. -->
        <xsd:element
          name="githubOAuthLogin"
          type="githubOAuthLoginType"
          minOccurs="0"
        />
        <!-- The login page's configurable IdP list, served to the frontend
             as JSON by GET /api/login/loginoptions (see
             pkg/api/loginoptions). -->
        <xsd:element
          name="loginOptions"
          type="loginOptionsType"
          minOccurs="0"
        />
        <!-- An origin ("scheme://host") the OAuth2/OIDC login handlers trust
             when their configured redirect URL is relative (starts with
             "/"): the origin of the incoming login request is prepended to
             the redirect URL only when it matches one of these entries.
             Specify the element multiple times to allow several origins,
             e.g. one per deployment environment alias. When no entry is
             present, relative redirect URLs are rejected. -->
        <xsd:element
          name="allowedOrigin"
          type="xsd:string"
          minOccurs="0"
          maxOccurs="unbounded"
        />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <!-- The configurable list of generic OIDC login providers; holds zero or
       more oidcLoginOption entries. -->
  <xsd:complexType name="oidcLoginOptionsType">
    <xsd:sequence>
      <xsd:element
        name="oidcLoginOption"
        type="oidcLoginOptionType"
        minOccurs="0"
        maxOccurs="unbounded"
      />
    </xsd:sequence>
  </xsd:complexType>

  <!-- A single OIDC provider configuration. Attribute names mirror the Go
       struct fields of GenericOIDCLoginHandler (with a lowercased first
       letter), and map directly onto the constructor parameters of
       NewGenericOIDCLoginHandler.

       Attributes with sensible code-side defaults are optional here:
         * providerName      defaults to "oidc"
         * scope             defaults to "openid profile email"
         * sessionLifespan   a Go time.Duration string (e.g. "168h")
         * loginSuccessRedirectURL  defaults to "/"

       Attributes without defaults are required:
         * issuerURL, clientId, clientSecret, redirectURL

       redirectURL may be relative (start with "/"), in which case the
       origin of the incoming request is prepended dynamically; the origin
       must match one of the <allowedOrigin/> entries of the document. -->
  <xsd:complexType name="oidcLoginOptionType">
    <xsd:attribute name="issuerURL" type="xsd:string" use="required" />
    <xsd:attribute name="clientId" type="xsd:string" use="required" />
    <xsd:attribute name="clientSecret" type="xsd:string" use="required" />
    <xsd:attribute name="redirectURL" type="xsd:string" use="required" />
    <xsd:attribute name="providerName" type="xsd:string" use="optional" />
    <xsd:attribute name="scope" type="xsd:string" use="optional" />
    <xsd:attribute name="sessionLifespan" type="xsd:string" use="optional" />
    <xsd:attribute
      name="loginSuccessRedirectURL"
      type="xsd:string"
      use="optional"
    />
  </xsd:complexType>

  <!-- The Github OAuth login provider configuration. Attribute names
       mirror the Go struct fields of GithubOAuthLoginHandler with the
       redundant GithubOAuth prefix dropped, and map directly onto the
       constructor parameters of NewGithubOAuthLoginHandler.

       Attributes with sensible code-side defaults are optional here:
         * loginPage        defaults to Github's authorize page
         * scope            defaults to "read:user"
         * tokenEndpoint    defaults to Github's token endpoint
         * sessionLifespan  a Go time.Duration string (e.g. "168h")
         * loginSuccessRedirectURL  defaults to "/"

       Attributes without defaults are required:
         * clientId, appSecret, redirectURL

       The handler is wired only when clientId is non-empty, so a sample
       element with empty values can ship in the configuration document
       unused. redirectURL may be relative (start with "/"), in which case
       the origin of the incoming request is prepended dynamically; the
       origin must match one of the <allowedOrigin/> entries of the
       document. -->
  <xsd:complexType name="githubOAuthLoginType">
    <xsd:attribute name="clientId" type="xsd:string" use="required" />
    <xsd:attribute name="appSecret" type="xsd:string" use="required" />
    <xsd:attribute name="redirectURL" type="xsd:string" use="required" />
    <xsd:attribute name="loginPage" type="xsd:string" use="optional" />
    <xsd:attribute name="scope" type="xsd:string" use="optional" />
    <xsd:attribute name="tokenEndpoint" type="xsd:string" use="optional" />
    <xsd:attribute name="sessionLifespan" type="xsd:string" use="optional" />
    <xsd:attribute
      name="loginSuccessRedirectURL"
      type="xsd:string"
      use="optional"
    />
  </xsd:complexType>

  <!-- The login page's configurable IdP list; holds zero or more loginOption
       entries. Served to the frontend as JSON by the login options API
       handler (pkg/api/loginoptions, GET /api/login/loginoptions). -->
  <xsd:complexType name="loginOptionsType">
    <xsd:sequence>
      <xsd:element
        name="loginOption"
        type="loginOptionType"
        minOccurs="0"
        maxOccurs="unbounded"
      />
    </xsd:sequence>
  </xsd:complexType>

  <!-- A single login option. kind identifies the IdP type and selects the
       login icon on the frontend; name is the option's unique key. Several
       options may share a kind under different names (e.g. "entra-public"
       and "entra-corporation", both with kind "entra"). Options with an
       empty loginURL are hidden by the login page.

       allowedOrigins is an optional comma-separated list of origins
       ("scheme://host"); empty (the default) means no restriction. When
       non-empty, GET /api/login/loginoptions serves the option only to
       requests whose origin appears in the list. -->
  <xsd:complexType name="loginOptionType">
    <xsd:attribute name="kind" type="xsd:string" use="required" />
    <xsd:attribute name="name" type="xsd:string" use="required" />
    <xsd:attribute name="displayName" type="xsd:string" use="required" />
    <xsd:attribute name="loginURL" type="xsd:string" use="required" />
    <xsd:attribute name="label" type="xsd:string" use="optional" />
    <xsd:attribute
      name="allowedOrigins"
      type="xsd:string"
      use="optional"
      default=""
    />
  </xsd:complexType>

  <!-- The <dynBlogData/> section; holds zero or more <postMetadata/>
       entries followed by zero or more <project/> entries, followed by zero
       or more <authorContact/> entries, followed by zero or more
       <shortlink/> entries. -->
  <xsd:complexType name="dynBlogDataType">
    <xsd:sequence>
      <xsd:element
        name="postMetadata"
        type="postMetadataType"
        minOccurs="0"
        maxOccurs="unbounded"
      />
      <xsd:element
        name="project"
        type="projectType"
        minOccurs="0"
        maxOccurs="unbounded"
      />
      <xsd:element
        name="authorContact"
        type="authorContactType"
        minOccurs="0"
        maxOccurs="unbounded"
      />
      <xsd:element
        name="shortlink"
        type="shortlinkType"
        minOccurs="0"
        maxOccurs="unbounded"
      />
    </xsd:sequence>
  </xsd:complexType>

  <!-- A single post entry of <dynBlogData/>: the metadata of one blog post.
       id uniquely identifies the post; href is where the card's Read button
       navigates (a site-relative path like "/posts/hello-world" or an
       external URL); title and description are shown on the card. creation
       is the publication date, lastModified the date of the last edit (both
       ISO dates, e.g. "2026-03-01"); lastModified is optional. tags is an
       optional comma-separated list rendered as chips (e.g. "go,notes");
       surrounding whitespace is ignored. -->
  <xsd:complexType name="postMetadataType">
    <xsd:attribute name="id" type="xsd:string" use="required" />
    <xsd:attribute name="href" type="xsd:string" use="required" />
    <xsd:attribute name="title" type="xsd:string" use="required" />
    <xsd:attribute name="description" type="xsd:string" use="required" />
    <xsd:attribute name="lastModified" type="xsd:string" use="optional" />
    <xsd:attribute name="creation" type="xsd:string" use="required" />
    <xsd:attribute name="tags" type="xsd:string" use="optional" default="" />
  </xsd:complexType>

  <!-- A single project entry of <dynBlogData/>. id uniquely identifies the
       entry; name, description, and url are shown on the project's card.
       tech is an optional comma-separated list of technologies (e.g.
       "Go,Next.js"), rendered as chips; surrounding whitespace is ignored. -->
  <xsd:complexType name="projectType">
    <xsd:attribute name="id" type="xsd:string" use="required" />
    <xsd:attribute name="name" type="xsd:string" use="required" />
    <xsd:attribute name="description" type="xsd:string" use="required" />
    <xsd:attribute name="url" type="xsd:string" use="required" />
    <xsd:attribute name="tech" type="xsd:string" use="optional" default="" />
  </xsd:complexType>

  <!-- A single author contact entry of <dynBlogData/>. id uniquely
       identifies the entry; kind picks the icon on the frontend ("email",
       "github", …); label is the button caption and url where it navigates
       (e.g. "mailto:you@example.com"). -->
  <xsd:complexType name="authorContactType">
    <xsd:attribute name="id" type="xsd:string" use="required" />
    <xsd:attribute name="kind" type="xsd:string" use="required" />
    <xsd:attribute name="label" type="xsd:string" use="required" />
    <xsd:attribute name="url" type="xsd:string" use="required" />
  </xsd:complexType>

  <!-- A single short link entry of <dynBlogData/>, served by
       ShortLinkHandler (pkg/api/links) under /links/. id uniquely identifies
       the entry and is the link's path segment (GET /links/{id} redirects to
       href); href is the destination — a site-relative path like
       "/posts/hello-world" or an absolute URL. The server re-reads the
       entries on every request (FsShortLinkDataProvider in
       pkg/models/shortlink), so edits apply without a server restart. -->
  <xsd:complexType name="shortlinkType">
    <xsd:attribute name="id" type="xsd:string" use="required" />
    <xsd:attribute name="href" type="xsd:string" use="required" />
  </xsd:complexType>

</xsd:schema>
